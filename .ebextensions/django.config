option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: src.core.wsgi:application

container_commands:
  01_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python src/manage.py collectstatic --noinput"
    leader_only: true
  02_migrate:
    command: "source /var/app/venv/*/bin/activate && python src/manage.py migrate --noinput"
    leader_only: true